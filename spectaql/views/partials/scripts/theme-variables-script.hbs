            "--admonition-info-title-bg":"rgba(59, 130, 246, 0.12)",
            "--admonition-danger-bg":"rgba(239, 68, 68, 0.08)",
            "--admonition-danger-border":"#dc2626",
            "--admonition-danger-title-color":"#b91c1c",
            "--admonition-danger-title-bg":"rgba(239, 68, 68, 0.12)",
            "--text-highlight-bg":"rgba(144, 202, 249, 0.35)",
            "--text-highlight-color":"inherit",
            "--hljs-background":"#f6f8fa",
            "--hljs-color":"#24292f",
            "--hljs-comment":"#6e7781",
