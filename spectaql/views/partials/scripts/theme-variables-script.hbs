            "--spectaql-code-background":"#212a3b",
            "--spectaql-code-background-subtle":"#2c3546",
            "--spectaql-code-text-color":"#b7c2d7",
            "--spectaql-sidebar-background":"#2c3546",
            "--spectaql-examples-background":"#2d3134",
            "--spectaql-scrollbar-thumb":"#464f60",
            "--spectaql-table-stripe":"#2c3546",
            "--spectaql-nav-group-title":"#8b95a9",
            "--spectaql-group-name-bg":"#2c3546",
