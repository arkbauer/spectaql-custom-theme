            "--hljs-built-in":"#953800",
            "--hljs-code":"#e12adf"
        };

        const defaultDarkTheme = {
            "--spectaql-background":"#212a3b",
            "--spectaql-background-subtle":"#2c3546",
            "--spectaql-text-color":"#b7c2d7",
            "--spectaql-text-color-subtle":"#808ba1",
            "--spectaql-link-color":"#DF0079",
            "--spectaql-link-color-hover":"#DF0079",
