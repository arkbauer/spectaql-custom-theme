            "--admonition-danger-bg":"rgba(239, 68, 68, 0.1)",
            "--admonition-danger-border":"#ef4444",
            "--admonition-danger-title-color":"#f87171",
            "--admonition-danger-title-bg":"rgba(239, 68, 68, 0.15)",
            "--text-highlight-bg":"rgba(100, 181, 246, 0.25)",
            "--text-highlight-color":"inherit",
            "--hljs-background":"#282c34",
            "--hljs-color":"#abb2bf",
            "--hljs-comment":"#5c6370",
            "--hljs-keyword":"#c678dd",
            "--hljs-name":"#e06c75",
            "--hljs-literal":"#56b6c2",
            "--hljs-string":"#98c379",
            "--hljs-attr":"#d19a66",
            "--hljs-number":"#b5cea8",
            "--hljs-title":"#61aeee",
            "--hljs-built-in":"#e6c07b",
            "--hljs-code":"#908aff"
        };

        const lightTheme = Object.assign({}, defaultLightTheme,
            { {{#each allOptions.themeVariables.lightTheme}}"{{@key}}": "{{this}}"{{#unless @last}}, {{/unless}}{{/each}} }
        );

        const darkTheme = Object.assign({}, defaultDarkTheme,
            { {{#each allOptions.themeVariables.darkTheme}}"{{@key}}": "{{this}}"{{#unless @last}}, {{/unless}}{{/each}} }
        );

        function applyVars(isDark) {
            const theme = isDark ? darkTheme : lightTheme;
            Object.entries(theme).forEach(function([key, value]) {
                document.body.style.setProperty(key, value);
            });
        }

        function init() {
            applyVars(document.body.classList.contains('spectaql-dark'));

            new MutationObserver(function() {
                applyVars(document.body.classList.contains('spectaql-dark'));
            }).observe(document.body, {
                attributes: true,
                attributeFilter: ['class']
            });
        }

        init();
    })();
</script>