            "--spectaql-code-copy-bg":"rgba(255, 255, 255, 0.05)",
            "--spectaql-code-copy-bg-hover":"rgba(255, 255, 255, 0.1)",
            "--spectaql-code-copy-color":"#808ba1",
            "--spectaql-code-copy-color-hover":"#b7c2d7",
